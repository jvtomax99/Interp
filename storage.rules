rules_version = '2';

/* Cloud Storage rules for the HUMC Interpreter Hub.
 *
 * Attachments -- photos and PDFs on terms, provider and doctor photos, chat
 * attachments, profile pictures -- all live under attachments/.
 *
 * Same door as firestore.rules: open while the Hub is in practice mode (or
 * before anyone has claimed it), and only for phones in hub-members/ once the
 * owner locks it. Reading those Firestore documents from here is a
 * cross-service rule; the first time these rules are published the console
 * asks to let Cloud Storage read Firestore. Say yes, or every photo breaks.
 *
 * Apply with:  firebase deploy --only storage
 * Or paste into console.firebase.google.com -> language-specialist ->
 * Storage -> Rules -> Publish.
 */
service firebase.storage {
  match /b/{bucket}/o {
    function practice() {
      return !firestore.exists(/databases/(default)/documents/hub-access/settings)
        || firestore.get(/databases/(default)/documents/hub-access/settings).data.get('practice', true) == true;
    }
    function isMember() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/hub-members/$(request.auth.uid));
    }

    match /attachments/{allPaths=**} {
      allow read, write: if isMember() || practice();
    }
  }
}
