+/* Interpreter Hub: the card for a tapped structure.
+   English name, Spanish name right under it, a speaker beside each, one or
+   two sentences on what it is, then the Hub tools and the sources. On a phone
+   it starts compact at the bottom and opens taller; on a wide screen it is a
+   side panel. Text comes only from the checked catalogue; a structure that
+   isn't in it says so instead of borrowing a description. */
+import {useEffect,useId,useRef} from 'react';
+import {ArrowUpRight,BookOpen,ChevronDown,ChevronRight,ChevronUp,Focus,GraduationCap,MessageCircleQuestion,Volume2,X} from 'lucide-react';
+import type {Concept,Part} from './anatomy';
+import {SYSTEMS} from './anatomy';
+import type {CardFor,GlossaryState,HubAction,HubCatalogue} from './hub';
+
+export interface Gloss {state:GlossaryState;domain:string}
+interface Props {
+ card:CardFor|null;chosen:Concept;piece:Part|undefined;pieces:Part[];onPiece:(id:string)=>void;catalogue:HubCatalogue|null;catalogueFailed:boolean;
+ gloss:Gloss|undefined;embedded:boolean;expanded:boolean;isolate:boolean;
+ onExpand:(open:boolean)=>void;onIsolate:()=>void;onClose:()=>void;onClear:()=>void;onAction:(a:HubAction,lang?:'en'|'es')=>void;
+}
+const SUPPORTS={en:'English name',es:'Spanish name',about:'explanation'} as const;
+const and=(xs:string[])=>xs.length>1?`${xs.slice(0,-1).join(', ')} and ${xs[xs.length-1]}`:xs.join('');
+
+export default function HubCard({card,chosen,piece,pieces,onPiece,catalogue,catalogueFailed,gloss,embedded,expanded,isolate,onExpand,onIsolate,onClose,onClear,onAction}:Props){
+ const uid=useId(),title=useRef<HTMLHeadingElement>(null),system=SYSTEMS.find(s=>s.id===piece?.system);
+ const s=card?.s,key=s?.id??chosen.id;
+ // A new structure: its name gets focus (as the old panel did), the card starts compact.
+ useEffect(()=>{title.current?.focus({preventScroll:true});},[key]);
+ const g=gloss?.state??'checking',hasTerm=g==='match'||g==='nospanish';
+ const status=!s?'':g==='checking'?'Checking the Hub glossary…':g==='match'?`In the Hub glossary${gloss?.domain?` · ${gloss.domain}`:''}`:
+  g==='nospanish'?`In the Hub glossary${gloss?.domain?` · ${gloss.domain}`:''}, without Spanish yet`:'Not in the Hub glossary yet';
+ const why=g==='none'?'Open glossary and Practice need a glossary entry. Dr. Smiley can still explain it.':g==='nospanish'?'Practice needs the Spanish in the glossary entry.':'';
+ const sideLine=card?.side?`${card.side.en} · ${card.side.es}`:'';
+ const name=s?.en??chosen.name;
+ const iso=(cls:string)=><button type="button" className={`hc-iso ${cls}`} aria-pressed={isolate} aria-label={isolate?'Show surrounding anatomy':'Isolate structure'} title={isolate?'Show surrounding anatomy':'Isolate structure'} onClick={onIsolate}><Focus size={16}/>{isolate?'Show all':'Isolate'}</button>;
+ return <section className={`hub-card ${expanded?'is-expanded':''} ${isolate?'is-isolated':''}`} aria-labelledby={`${uid}-t`} data-card={s?.id??''}>
+  <div className="hc-head">
+   <div className="hc-names">
+    <div className="hc-name"><h2 ref={title} tabIndex={-1} id={`${uid}-t`} lang="en">{name}</h2>{s&&embedded&&<button type="button" className="hc-say" aria-label={`Hear ${s.en} in English`} onClick={()=>onAction('pronounce','en')}><Volume2 size={17}/><span>EN</span></button>}</div>
+    <div className="hc-name hc-es">{s?.es?<><p lang="es">{s.es}</p>{embedded&&<button type="button" className="hc-say" aria-label={`Hear ${s.es} in Spanish`} onClick={()=>onAction('pronounce','es')}><Volume2 size={17}/><span>ES</span></button>}</>:<p className="hc-missing">Spanish name not added yet</p>}</div>
+   </div>
+   <div className="hc-ctl">
+    <button type="button" className="hc-icon" aria-label="Close" onClick={onClose}><X size={20}/></button>
+    <button type="button" className="hc-icon hc-phone" aria-expanded={expanded} aria-controls={`${uid}-more`} aria-label={expanded?'Show less':'Show more'} onClick={()=>onExpand(!expanded)}>{expanded?<ChevronDown size={20}/>:<ChevronUp size={20}/>}</button>
+   </div>
+  </div>
+  <div className="hc-body">
+   {sideLine&&<p className="hc-side">{sideLine}</p>}
+   {s?<p className="hc-about">{s.about}</p>:<div className="hc-system"><span>About this body system{system?` · ${system.name}`:''}</span><p>{system?.description??''}</p></div>}
+   {s&&embedded&&<div className="hc-tools" role="group" aria-label="Hub tools">
+     <button type="button" disabled={!hasTerm} aria-describedby={`${uid}-why`} onClick={()=>onAction('glossary')}><BookOpen size={21}/><span>Open glossary</span></button>
+     <button type="button" disabled={g!=='match'} aria-describedby={`${uid}-why`} onClick={()=>onAction('practice')}><GraduationCap size={21}/><span>Practice this term</span></button>
+     <button type="button" className="hc-ask" onClick={()=>onAction('ask')}><MessageCircleQuestion size={21}/><span>Ask Dr. Smiley</span></button>
+   </div>}
+   <div className="hc-row">
+    {s&&embedded?<p className={`hc-status is-${g}`} id={`${uid}-why`} role="status"><b>{status}</b>{why&&<span> {why}</span>}</p>:!s?<p className="hc-note">{catalogueFailed?'The Hub’s list of checked structures couldn’t be loaded, so there’s no Spanish name or Hub tools here right now.':'This structure isn’t in the Hub’s checked list yet, so there’s no Spanish name or Hub tools for it.'}</p>:<span/>}
+    {iso('hc-phone')}
+   </div>
+   <div className="hc-more" id={`${uid}-more`}>
+    {s?.esNote&&<p className="hc-esnote"><b lang="es">ES</b>{s.esNote}</p>}
+    {card?.via&&<p className="hc-via">Selected piece: <b>{card.via}</b> (part of the {s!.en.toLowerCase()})</p>}
+    <div className="hc-view hc-wide">
+     <button type="button" className="hc-iso hc-iso-wide" aria-pressed={isolate} onClick={onIsolate}><Focus size={18}/>{isolate?'Show surrounding anatomy':'Isolate structure'}</button>
+    </div>
+    {pieces.length>1&&<details className="member-list hc-members"><summary>Included structures ({pieces.length.toLocaleString()})</summary>{pieces.slice(0,50).map(p=><button type="button" key={p.id} onClick={()=>onPiece(p.id)}><span>{p.name}</span><ChevronRight size={14}/></button>)}{pieces.length>50&&<p>And {(pieces.length-50).toLocaleString()} more modeled pieces.</p>}</details>}
+    <details className="hc-sources">
+     <summary>Sources</summary>
+     {s&&<><h3>Card text</h3><ul>{s.sources.map(x=><li key={x.url}><a href={x.url} target="_blank" rel="noreferrer" lang={x.lang}>{x.title}<ArrowUpRight size={12}/></a><span>{x.publisher} · supports the {and(x.supports.map(k=>SUPPORTS[k]))}</span></li>)}</ul></>}
+     <h3>3D model</h3>
+     <p>{catalogue?.geometry.title||'BodyParts3D'}, © {catalogue?.geometry.publisher||'The Database Center for Life Science'}, {catalogue?.geometry.licence||'CC BY 4.0'}. The shapes come from it; the card text does not.</p>
+     <p className="hc-ref">Atlas reference <b>{chosen.id}</b>{s&&s.id!==chosen.id&&<> · card <b>{s.id}</b></>} · {pieces.length.toLocaleString()} {pieces.length===1?'piece':'pieces'}</p>
+    </details>
+    <button type="button" className="hc-clear" onClick={onClear}>Clear selection</button>
+   </div>
+  </div>
+ </section>;
+}
