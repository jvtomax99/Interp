diff -ruN pa/app/globals.css pb/app/globals.css
--- a/app/globals.css	2026-10-07 00:50:02.768431304 +0000
+++ b/app/globals.css	2026-10-07 00:50:02.769792012 +0000
@@ -86,3 +86,63 @@
 @media(max-width:767px){body:has(.detail-sheet) .view-controls{visibility:hidden}}
 
 @media(max-height:600px) and (orientation:landscape){body:has(.detail-sheet) .bottom-dock{left:12px;right:324px;width:auto;transform:none;max-width:none;margin:0}}
+
+/* Interpreter Hub: a dark stage, so pale structures (bone, lungs, fat,
+   cartilage) stand out, and no floor, so the soles of the feet can be seen
+   from below. Text that sits straight on the stage is lightened to match;
+   the white panels keep their own colours. */
+:root{background:#0F1524}
+.studio{background:radial-gradient(ellipse 75% 62% at 50% 44%,#2B3858 0%,#1B2440 52%,#0F1524 100%)}
+.vignette{background:radial-gradient(ellipse at 51% 43%,transparent 48%,#0000004d 100%)}
+.eyebrow{color:#9FB0C8}
+h1{color:#F3F6FB}
+h1 em{color:#B9C6D8}
+h1 .edition{color:#C9D4E3;border-color:#ffffff38}
+.identity-meta{color:#9FB0C8}
+.identity-meta span{color:#7F8FA8}
+.scene-caption{color:#8C9BB3}
+.caption-line{background:#ffffff2e}
+.studio-footer,.studio-footer button{color:#A9B8CD}
+.studio-footer b{color:#6E7E97}
+.loading span{color:#A9B8CD}
+.loading-track{background:#ffffff24}
+.glass{background:#fffffffa}
+.bottom-dock{background:#fffffffa}
+.top-actions button{background:#fffffff2}
+
+/* Interpreter Hub, phones. The Hub's own top bar already names the screen,
+   so the big title goes and the body gets the room: one row of controls at
+   the top, a slim dock at the bottom, and a short card where the dock was
+   when a part is tapped. Reset and About each had two buttons; one stays.
+   touch-action keeps a pinch on the controls from zooming the whole Hub. */
+@media(max-width:767px){
+ .studio{touch-action:none}
+ .system-list,.detail-scroll,.anatomy-search-results,.about-sheet,.member-list{touch-action:pan-y}
+ .identity,.scene-caption{display:none}
+ .top-actions .icon-button{display:none}
+ .top-actions{top:max(10px,env(safe-area-inset-top));right:10px}
+ .view-controls{top:max(10px,env(safe-area-inset-top));left:10px;right:auto;margin:0;padding:3px;gap:0}
+ .view-controls button{width:38px;height:44px}
+ .view-controls i{margin:8px 3px}
+ .search-panel{top:max(64px,calc(env(safe-area-inset-top) + 54px))}
+ .bottom-dock{bottom:calc(26px + env(safe-area-inset-bottom));padding:6px 14px 6px 6px;gap:10px;border-radius:14px}
+ .dock-layers{flex-direction:row;gap:7px;font-size:13px;padding:0 12px 0 8px;min-height:44px}
+ .dock-reset{display:none}
+ .explode-label{margin-bottom:0;font-size:12px}
+ .explode-label output{padding:1px 6px;min-width:42px}
+ .explode-control [data-slot=slider]{padding-block:10px}
+ .slider-endpoints{display:none}
+ .studio-footer{bottom:calc(4px + env(safe-area-inset-bottom))}
+ .layers-panel.mobile-open{bottom:calc(96px + env(safe-area-inset-bottom));max-height:calc(100dvh - 170px)}
+ .has-detail .bottom-dock{display:none}
+ .detail-sheet{bottom:calc(10px + env(safe-area-inset-bottom))!important;max-height:40dvh;padding:14px 16px!important;gap:8px!important}
+ .detail-sheet.is-isolated{max-height:40dvh}
+ .detail-header .structure-title{font-size:19px!important}
+ .structure-description{font-size:14px!important;line-height:1.5!important}
+ .context-note,.structure-meta,.detail-scroll>.source-link{display:none}
+ .detail-actions{flex-direction:row;align-items:center;gap:8px;padding-top:4px}
+ .detail-actions .primary-action{flex:1;min-height:44px}
+}
+/* Interpreter Hub: the explode track drew 0px tall, so only the knob showed. */
+.explode-control [data-slot=slider-track]{height:4px;border-radius:2px}
+.explode-control [data-slot=slider-range]{height:100%;border-radius:2px}
