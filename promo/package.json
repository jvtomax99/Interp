{
  "name": "hub-promo",
  "private": true,
  "description": "Remotion project for the Hub's promo videos (media/). Not part of the app; kept out of the deploy by .vercelignore.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render HubPromo out/hub-promo.mp4 --crf=27 --x264-preset=slow",
    "shots": "cd .. && node promo/capture/shots.cjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
